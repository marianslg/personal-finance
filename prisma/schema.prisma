generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Currency {
  id               Int        @id @default(autoincrement())
  code             String     @unique
  name             String
  snapshotPosition Int?
  snapshotVisible  Boolean    @default(true)
  snapshots        Snapshot[]
}

model Account {
  id               Int        @id @default(autoincrement())
  name             String
  snapshotPosition Int?
  snapshotVisible  Boolean    @default(true)
  snapshots        Snapshot[]
  createdAt        DateTime   @default(now())
}

model Snapshot {
  id              Int      @id @default(autoincrement())
  account         Account  @relation(fields: [accountId], references: [id])
  accountId       Int
  currency        Currency @relation(fields: [currencyId], references: [id])
  currencyId      Int
  quantity        Decimal  @db.Decimal(30, 10) // cantidad de BTC/ETH/usd...
  pricePerUnitUSD Decimal  @db.Decimal(30, 10) // cotización en USD al momento del snapshot
  notes           String?
  snapshotDate    DateTime @default(now()) // fecha para agrupar snapshots
}
